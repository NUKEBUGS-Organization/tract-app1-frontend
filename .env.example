# Local dev — backend on port 3000
VITE_API_BASE_URL=http://localhost:3000/api/v1

# CapRover may use either name (both work after build):
# VITE_API_URL=https://seller-backend.tractcorp.com/api/v1
# VITE_API_BASE_URL=https://seller-backend.tractcorp.com/api/v1
# VITE_SOCKET_URL=https://seller-backend.tractcorp.com

# Same-origin proxy alternative:
#   VITE_API_BASE_URL=/api/v1
#   Runtime: API_UPSTREAM=http://srv-captain--YOUR-BACKEND-APP

# Support-ticket endpoints (app2 buyer-backend).
# Dev: Vite proxies /tickets-api/* → buyer-backend, no CORS needed.
# Production: use the full URL.
# VITE_TICKETS_API_BASE_URL=/tickets-api/v1                              ← local dev (default)
# VITE_TICKETS_API_BASE_URL=https://buyer-backend.tractcorp.com/api/v1  ← production