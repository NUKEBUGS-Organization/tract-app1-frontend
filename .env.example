# Local dev — backend on port 3000
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Production (CapRover / Docker frontend):
#   Build arg:  VITE_API_BASE_URL=/api/v1
#   Runtime env on frontend app: API_UPSTREAM=http://srv-captain--YOUR-BACKEND-APP
# Do NOT use /auth — routes are auth/register under /api/v1, not /auth/auth/register.